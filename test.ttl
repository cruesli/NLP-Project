@prefix ex: <http://example.org/recipe-kg/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:recipe_test-recipe a ex:Recipe ;
    ex:approxKcalPerServing 90.0 ;
    ex:approxProteinPerServing 12.5 ;
    ex:cuisine "italian" ;
    ex:hasIngredient ex:ing_test-recipe_0 ;
    ex:servings 2 ;
    ex:slug "test-recipe" ;
    ex:title "Test" ;
    ex:totalTimeMinutes 30 .

ex:ing_test-recipe_0 a ex:Ingredient ;
    ex:foodCategory "poultry" ;
    ex:hasNutrition ex:nutr_test-recipe_0 ;
