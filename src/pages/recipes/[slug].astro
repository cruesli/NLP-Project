---
import { existsSync } from "node:fs";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../utils/withBase";
export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;

const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.slug === slug);

if (!recipe) {
  throw new Error(`Recipe not found: ${slug}`);
}

const { Content } = await recipe.render();
const d = recipe.data;

const rawIngredients = d.ingredients as unknown;
const ingredients: string[] = Array.isArray(rawIngredients)
  ? (rawIngredients as string[])
  : typeof rawIngredients === "string"
  ? (rawIngredients as string)
      .split(/\r?\n/)
      .map((line: string) => line.trim().replace(/^-+\s*/, ""))
      .filter(Boolean)
  : [];

const apiUrl: string = (import.meta as any).env?.PUBLIC_API_URL ?? "http://localhost:8000";

const imagePath = d.image?.trim() || "";
const hasImage =
  imagePath.length > 0 &&
  existsSync(join(process.cwd(), "public", imagePath.replace(/^\//, "")));
---

<BaseLayout title={d.title}>
  <article class="recipe">
    <h1>{d.title}</h1>

    <div class="badges" style="margin-bottom: 12px;">
      <span class="badge" style="text-transform: capitalize;">{d.cuisine}</span>
      {d.foodType ? <span class="badge">{d.foodType}</span> : null}
      {typeof d.totalTimeMinutes === "number" ? <span class="badge">{d.totalTimeMinutes} min</span> : null}
      {typeof d.servings === "number" ? <span class="badge">{d.servings} servings</span> : null}
      {d.tags?.map((t) => <span class="badge">{t}</span>)}
    </div>

    <div id="nutrition-panel" hidden></div>

    {hasImage ? <img src={withBase(imagePath)} alt={d.title} loading="lazy" /> : null}

    {ingredients.length ? (
      <section style="margin-top: 16px;">
        <h2>Ingredients</h2>
        <ul>
          {ingredients.map((ingredient: string) =>
            ingredient.endsWith(":") ? (
              <li class="ingredients-header">{ingredient}</li>
            ) : (
              <li>{ingredient}</li>
            )
          )}
        </ul>
      </section>
    ) : null}

    <section style="margin-top: 16px;">
      <h2>Steps</h2>
      <Content />
    </section>
  </article>
</BaseLayout>

<script is:inline define:vars={{ slug, apiUrl }}>
  (async () => {
    try {
      const res = await fetch(`${apiUrl}/api/v1/recipes/${slug}`);
      if (!res.ok) return;
      const data = await res.json();
      const n = data.nutritionPerServing;
      if (!n) return;
      const fmt = (v, unit) => v != null ? `${+(Math.round(v * 10) / 10)}${unit}` : null;
      const items = [
        fmt(n.kcal, ' kcal'),
        fmt(n.proteinG, 'g protein'),
        fmt(n.fatG, 'g fat'),
        fmt(n.carbsG, 'g carbs'),
      ].filter(Boolean);
      if (!items.length) return;
      const panel = document.getElementById('nutrition-panel');
      panel.innerHTML =
        '<p style="margin:8px 0 4px;font-size:13px;opacity:0.6;">Per serving</p>' +
        '<div class="badges">' +
        items.map(v => `<span class="badge">${v}</span>`).join('') +
        '</div>';
      panel.hidden = false;
    } catch (_) {}
  })();
</script>
