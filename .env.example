# CampusAI (OpenAI-compatible LLM proxy — requires DTU network/VPN)
# CAMPUSAI_API_KEY=your-api-key-here
# CAMPUSAI_BASE_URL=https://console.campusai.compute.dtu.dk
# CAMPUSAI_MODEL=gemma-3-27b-it

# Ollama (local fallback — run: ollama pull gemma4:e2b)
CAMPUSAI_API_KEY=ollama
CAMPUSAI_BASE_URL=http://localhost:11434/v1
CAMPUSAI_MODEL=gemma4:e2b

# USDA FoodData Central (free, no auth needed — leave blank or omit)
# USDA_API_KEY=
